# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Return Zero API (get from https://developers.vito.ai)
RTZR_CLIENT_ID=your-rtzr-client-id
RTZR_CLIENT_SECRET=your-rtzr-client-secret

# Anthropic API (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# App Security
SECRET_KEY=generate-a-random-secret-key-here

# Optional: Override defaults
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/streamauto
# REDIS_URL=redis://localhost:6379/0
